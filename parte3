{"cells":[{"cell_type":"code","source":["# ==========================================================\n","# INTRODUCCIÓN A PANDAS-C\n","# ==========================================================\n","# Este script muestra:\n","# 1. Creación de DataFrames\n","# 2. Creación de Series\n","# 3. Lectura de CSV\n","# 4. Exploración de datos\n","# 5. Escritura de CSV\n","# ==========================================================\n","\n","\n","# ==========================================================\n","# 1. IMPORTACIÓN DE LIBRERÍAS\n","# ==========================================================\n","\n","import pandas as pd\n","\n","\n","# ==========================================================\n","# 2. CREACIÓN DE DATAFRAME\n","# ==========================================================\n","\n","# DataFrame numérico\n","df_numerico = pd.DataFrame({\n","    'Yes': [50, 21],\n","    'No': [131, 2]\n","})\n","\n","print(\"DataFrame numérico:\")\n","print(df_numerico)\n","print()\n","\n","\n","# DataFrame con texto\n","df_texto = pd.DataFrame({\n","    'Bob': ['Me gusta.', 'Horroroso.'],\n","    'Sue': ['Muy bien.', 'Un poco soso.']\n","})\n","\n","print(\"DataFrame con texto:\")\n","print(df_texto)\n","print()\n","\n","\n","# DataFrame con índice personalizado\n","df_indice = pd.DataFrame({\n","    'Bob': ['Me gusta.', 'Horroroso.'],\n","    'Sue': ['Muy bien.', 'Un poco soso.']\n","},\n","index=['Producto A', 'Producto B'])\n","\n","print(\"DataFrame con índice personalizado:\")\n","print(df_indice)\n","print()\n","\n","\n","# ==========================================================\n","# 3. CREACIÓN DE SERIES\n","# ==========================================================\n","\n","# Serie simple\n","serie_simple = pd.Series([1, 2, 3, 4, 5])\n","\n","print(\"Serie simple:\")\n","print(serie_simple)\n","print()\n","\n","\n","# Serie personalizada con índice y nombre\n","serie_personalizada = pd.Series(\n","    [30, 35, 40],\n","    index=['Ventas 2015', 'Ventas 2016', 'Ventas 2017'],\n","    name='Producto A'\n",")\n","\n","print(\"Serie personalizada:\")\n","print(serie_personalizada)\n","print()\n","\n","\n","# ==========================================================\n","# 4. LECTURA DE DATASET CSV\n","# ==========================================================\n","\n","# Leer archivo CSV\n","# Asegúrate de que la ruta exista\n","try:\n","    ryanair_reviews = pd.read_csv(\"datasets/ryanair_reviews.csv\")\n","\n","    print(\"Dimensiones del DataFrame (filas, columnas):\")\n","    print(ryanair_reviews.shape)\n","    print()\n","\n","    print(\"Primeras 5 filas:\")\n","    print(ryanair_reviews.head())\n","    print()\n","\n","except FileNotFoundError:\n","    print(\"Error: No se encontró el archivo 'datasets/ryanair_reviews.csv'\")\n","    ryanair_reviews = None\n","\n","\n","# ==========================================================\n","# 5. USAR UNA COLUMNA COMO ÍNDICE\n","# ==========================================================\n","\n","if ryanair_reviews is not None:\n","    ryanair_reviews = pd.read_csv(\n","        \"datasets/ryanair_reviews.csv\",\n","        index_col=0\n","    )\n","\n","    print(\"DataFrame usando la primera columna como índice:\")\n","    print(ryanair_reviews.head())\n","    print()\n","\n","\n","# ==========================================================\n","# 6. ESCRITURA DE DATAFRAME EN CSV\n","# ==========================================================\n","\n","if ryanair_reviews is not None:\n","    ryanair_reviews.to_csv(\n","        \"datasets/ryanair_reviews_modified.csv\",\n","        index=True  # Guarda el índice en el archivo\n","    )\n","\n","    print(\"Archivo guardado correctamente como:\")\n","    print(\"datasets/ryanair_reviews_modified.csv\")"],"metadata":{"id":"JJcF5FH0ybPQ","executionInfo":{"status":"ok","timestamp":1772173773574,"user_tz":360,"elapsed":186,"user":{"displayName":"","userId":""}},"outputId":"7557c78b-be55-46fc-8103-d13bf5d1b3a7","colab":{